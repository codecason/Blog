<div data-tag-browser data-initial-tag="<%= page.tag || '' %>" data-page-size="<%= config.per_page || 10 %>" hidden>
  <div class="writing-toolbar" id="tag-filters"><div class="article-filters" role="group" aria-label="按标签筛选文章">
    <button type="button" data-tag="" aria-pressed="true">全部</button>
    <% site.tags.sort('name',1).each(function(tag) { %><button type="button" data-tag="<%= tag.name %>" aria-pressed="false"><%= tag.name %></button><% }) %>
  </div></div>
  <p class="results-label" role="status" aria-live="polite" data-filter-status></p>
  <div class="article-list">
    <% site.posts.sort('date',-1).each(function(post) { %>
    <a class="article-row" data-filter-row data-tags="<%= JSON.stringify(post.tags.map(t => t.name)) %>" href="<%- url_for(post.path) %>">
      <span class="mono" data-row-number></span><div><h3><%= post.title || '未命名文章' %></h3>
      <div class="article-meta"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><% post.tags.each(function(t) { %><span><%= t.name %></span><% }) %></div></div><span aria-hidden="true">↗</span>
    </a><% }) %>
  </div>
  <p class="empty-state" data-filter-empty hidden>这个标签下暂时没有文章，请选择其他标签或“全部”。</p>
  <div class="article-list-footer"><button class="button button-outline" type="button" data-filter-more hidden>显示更多</button></div>
</div>
